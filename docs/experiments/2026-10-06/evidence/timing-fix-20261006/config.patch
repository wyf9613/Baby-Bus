     # to timer mode if the chosen sensor stops, and no simultaneous triggers.
     # Integrated control uses ONE 20 Hz timer. Cones are still measured at the
     # detector's rate; estimation re-aligns the cached geometry using motion
-    # history. This leaves margin under the planner's 0.1 s reference deadline.
+    # history. This leaves margin under the planner's 0.2 s reference deadline.
     policy_update_mode: timer
 
     # Timer-mode frequency in Hz (positive finite double; default 50.0).
@@ -141,7 +141,7 @@
       # Forward no-slip planar model; wheel time is receipt, NOT acquisition.
       # Missing/old motion or a gap rejects geometry instead of retimestamping.
       motion_max_gap_s: 0.15
