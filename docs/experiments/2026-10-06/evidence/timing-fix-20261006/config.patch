       min_cone_confidence: 0.5
@@ -170,13 +170,13 @@
     # response; use a short straight corridor with both cone boundaries.
     planning:
       cruise_speed_mps: 0.2
-      max_source_age_s: 0.2
-      reference_lifetime_s: 0.1
+      max_source_age_s: 0.4
+      reference_lifetime_s: 0.2
       # Actual supported x range, metres; do not extrapolate to the car origin.
