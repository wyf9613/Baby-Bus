+      max_curvature_1pm: 0.15
       max_lateral_offset_m: 0.2
       max_heading_error_rad: 0.15
       max_sample_gap_m: 0.25
@@ -208,12 +208,12 @@
       # MVP uses direct normalized steering and ignores this geometry selector.
       vehicle_params_source: upstream
       # Distance is raw-wheel-speed integration per explicit policy run. At
